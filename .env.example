# Copia a .env (nunca se sube al repo: está en .gitignore) y ajusta.
# Con solo `docker compose up --build` funcionan los valores por defecto (demo local).

# Puerto del portal en el host (5500 puede estar ocupado; 5501 por defecto)
FRONTEND_PORT=5501

# Base de datos
POSTGRES_DB=autogestion
POSTGRES_USER=autogestion
POSTGRES_PASSWORD=autogestion2024

# Secreto JWT (cámbialo en producción: mínimo 32 caracteres aleatorios)
APP_JWT_SECRET=dev-only-cambialo-en-produccion-0123456789abcdef

# Admin de arranque (se crea si no existe, siempre)
APP_ADMIN_EMAIL=admin@sanmartin.pe
APP_ADMIN_PASSWORD=Admin-2026*

# Datos de demostración (clientes, vehículos, equipo demo). En producción: false.
APP_SEED_DEMO=true

# Claves iniciales del equipo demo (distintas por rol; rotan en Equipo > Clave)
APP_SEED_PASSWORD_MECANICO=Meca-2026*
APP_SEED_PASSWORD_ALMACEN=Alma-2026*
APP_SEED_PASSWORD_RECEPCIONISTA=Recep-2026*

# Padrón Reducido RUC de SUNAT (dato público, sin API key).
# Se usa para RUC y, si la persona tiene RUC 10, también para autocompletar el DNI.
# Descarga padron_reducido_ruc.zip (~394 MB) y déjalo en ./padron/ (se monta en /padron).
# Luego, como ADMIN: POST /api/admin/padron-ruc/importar  (estado: GET /api/admin/padron-ruc/estado)
PADRON_RUC_SOLO_ACTIVOS=false
PADRON_RUC_IMPORTAR_AL_INICIAR=false
PADRON_RUC_ARCHIVO=/padron/padron_reducido_ruc.zip

# Consulta de DNI: RENIEC NO tiene API pública gratuita. Necesitas un proveedor autorizado
# (Decolecta, etc.) y su token. Sin token, el portal usa el padrón SUNAT (si está importado)
# y luego dniperu.com (fuente gratuita de abajo); el modo manual queda como último recurso.
RENIEC_DNI_TOKEN=
# URL del proveedor (admite {numero} en la ruta) y si exige token.
# Ejemplos compatibles: Decolecta (por defecto), https://apiperu.dev/api/dni/{numero}
# o https://api.apis.net.pe/v2/reniec/dni (este último agrega ?numero=...).
RENIEC_DNI_URL=https://api.decolecta.com/v1/reniec/dni
RENIEC_DNI_REQUIERE_TOKEN=true
# Límite de consultas públicas por IP (anti-enumeración)
RENIEC_CONSULTA_MAX=12
RENIEC_CONSULTA_VENTANA_MIN=10

# DNI sin RUC 10: Scrall (tercero, plan API Básico gratuito). Requiere registro.
# Regístrate en https://dashboard.scrall.net, copia tu clave API y pégala aquí.
# No la compartas ni la subas al repositorio. Vacío = deshabilitado.
SCRALL_API_KEY=
SCRALL_DNI_URL=https://api.scrall.net/v1/reniec/basico

# DNI gratis sin clave: dniperu.com (tercero no oficial, consultado DESDE EL BACKEND).
# Su sitio no envía CORS, por eso el navegador no puede llamarlo: lo hace el servidor.
# Sus términos restringen la consulta automatizada; pon false para deshabilitarlo.
DNIPERU_DNI_HABILITADO=true
DNIPERU_DNI_BASE_URL=https://dniperu.com

# RUC gratis sin clave: openruc.com (complementa al Padrón Reducido de SUNAT).
OPENRUC_RUC_HABILITADO=true
OPENRUC_RUC_URL=https://openruc.com/api/ruc

# WhatsApp de atención para el centro de soporte (vacío = no se muestra)
APP_EMPRESA_WHATSAPP=
